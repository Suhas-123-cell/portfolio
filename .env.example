# Groq — chat completion (see api/chat.ts)
GROQ_API_KEY=

# Groq model ID — defaults to openai/gpt-oss-20b (fast, cheap, free-tier friendly) if unset.
# Full list: https://console.groq.com/docs/models
# Note: llama-3.1-8b-instant and llama-3.3-70b-versatile were deprecated June 2026.
GROQ_MODEL=openai/gpt-oss-20b
